# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ── Salesforce Connected App ──────────────────────────────────────────────────
# From Setup → App Manager → your Connected App → Manage Consumer Details
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret

# The login URL for your org (production or sandbox)
SF_LOGIN_URL=https://login.salesforce.com

# Your org's My Domain instance URL (e.g. https://mycompany.my.salesforce.com)
# Populated automatically after first OAuth flow — or paste it manually.
SF_INSTANCE_URL=

# OAuth access token — populated at runtime via Connected App OAuth flow.
# For local dev you can paste a token here temporarily; clear it when done.
SF_ACCESS_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Anthropic / VER Agent ─────────────────────────────────────────────────────
# Required for /api/agent/stream
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional model override
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Coupa API (for query_coupa tool) ──────────────────────────────────────────
COUPA_BASE_URL=https://<your-tenant>.coupahost.com
COUPA_CLIENT_ID=your_coupa_client_id
COUPA_CLIENT_SECRET=your_coupa_client_secret
COUPA_SCOPE=core.purchase_order.read

# ── Redis (optional, production memory backend) ───────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Okta (populated by Forge hosting environment — do not set locally) ────────
# OKTA_ISSUER=
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
